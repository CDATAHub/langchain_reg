# Backend Environment Variables
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Backend Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Storage Settings
STORAGE_DIR=./combined_storage
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports

# LLM Settings
LLM_MODEL=deepseek-v3
EMBEDDING_MODEL=text-embedding-v1
TEMPERATURE=0.1
TOP_P=0.8

# Chunking Settings
CHUNK_SIZE=1024
CHUNK_OVERLAP=100
MAX_SEARCH_RESULTS=5

# WebSocket Settings
WS_MAX_CONNECTIONS=100
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10